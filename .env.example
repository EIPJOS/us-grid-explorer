OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-5.5
FEED_GENERATION_MODEL=gpt-5.4-mini-medium
FEED_BATCH_TIMEZONE=America/New_York
FEED_BATCH_HOUR=6
VITE_ANALYTICS_ENABLED=false
VITE_GOOGLE_SITE_VERIFICATION=
CONTENT_PIPELINE_ENABLED=true
AUTO_PUBLISH=false
MIN_RELEVANCE_SCORE=70
MAX_ARTICLES_PER_RUN=3

# Grid Permit Alerts paid tier (Stripe) -- see docs/STRIPE_SETUP.md.
# SUPABASE_URL and SUPABASE_ANON_KEY are also required (see api/watch-articles.js)
# but already set in Vercel; SUPABASE_SERVICE_KEY below is new.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LOUDOUN_VA=
SUPABASE_SERVICE_KEY=
